{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["public/app.js"]
}
